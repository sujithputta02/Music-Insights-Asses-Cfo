# Database
# For Vercel/serverless environments, use transaction pooling (port 6543 for Supabase)
# Note: Port 6543 uses PgBouncer automatically, no pgbouncer=true parameter needed for Prisma
DATABASE_URL="postgresql://user:password@host:6543/database?connection_limit=1"

# For local development and migrations, use direct connection (port 5432)
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# AI API Keys (Use ONE - Groq is recommended for speed and cost)
# Groq API (Recommended: 10x faster, free tier: 30 req/min, 7000 req/day)
GROQ_API_KEY="your_groq_api_key_here"

# OpenAI API (Alternative: Higher quality but slower and paid)
OPENAI_API_KEY="your_openai_api_key_here"

# JWT Secret for authentication (REQUIRED - must be 32+ characters)
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_32_PLUS_CHARACTERS"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting (Optional)
# Set to "true" to disable rate limiting during testing/development
# WARNING: Never set this to "true" in production!
# DISABLE_RATE_LIMITING="false"
